# Copy this file to .env and fill in real values before running docker compose.
# Never commit .env (it's gitignored).

# ---- MongoDB ----
# Use MongoDB Atlas (recommended) or a local mongod via Homebrew.
# For local Docker mongo (uncomment the mongo service in docker-compose.yml):
#   MONGODB_URI=mongodb://mongo:27017
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=taskplatform

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-32-bytes-of-random-hex

# ---- Redis ----
# Defaults to the in-network Redis service from docker-compose. Override only
# if pointing at an external Redis (e.g. Upstash, Redis Cloud).
REDIS_URL=redis://redis:6379
BULL_QUEUE_NAME=task-queue

# ---- Logging ----
LOG_LEVEL=info
