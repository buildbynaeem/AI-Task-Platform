modules = ["nodejs-24", "python-3.11"]

[deployment]
run = "node artifacts/api-server/dist/index.mjs"
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Worker"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Redis"

[[workflows.workflow]]
name = "Worker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd worker && python main.py"
waitForPort = 8008

[[workflows.workflow]]
name = "Redis"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "redis-server --port 6379 --bind 127.0.0.1 --save '' --appendonly no"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[nix]
channel = "stable-25_05"

[userenv.shared]
REDIS_URL = "redis://127.0.0.1:6379"
BULL_QUEUE_NAME = "ta"

[[ports]]
localPort = 8008
externalPort = 8008

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 22333
externalPort = 3000
